	column ventana_completa =
			fact_reposicion[fecha_revision] + fact_reposicion[cobertura_dias] - 1 <= MAX ( fact_predicciones[fecha] )
		dataType: boolean
		lineageTag: b46ed266-c42c-4d42-9417-a0e2ecf00abd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column tramo_demanda =
			SWITCH ( TRUE (),
			    fact_reposicion[demanda_esperada] < 1, "Menos de 1",
			    fact_reposicion[demanda_esperada] < 3, "De 1 a 3",
			    fact_reposicion[demanda_esperada] < 10, "De 3 a 10",
			    fact_reposicion[demanda_esperada] < 30, "De 10 a 30",
			    "30 o más" )
		dataType: string
		lineageTag: ed4b2665-a445-439f-8b08-4e185f794032
		summarizeBy: none
		sortByColumn: orden_tramo

		annotation SummarizationSetBy = Automatic

	column orden_tramo =
			SWITCH ( TRUE (),
			    fact_reposicion[demanda_esperada] < 1, 1,
			    fact_reposicion[demanda_esperada] < 3, 2,
			    fact_reposicion[demanda_esperada] < 10, 3,
			    fact_reposicion[demanda_esperada] < 30, 4,
			    5 )
		dataType: int64
		formatString: 0
		lineageTag: e12b9c72-ef35-4ad3-8faf-b40d4207f387
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column revision_txt =
			FORMAT ( fact_reposicion[fecha_revision], "dd/mm" )
		dataType: string
		lineageTag: 0572bb6f-a36c-4f1d-b164-0fce488722c3
		summarizeBy: none
		sortByColumn: fecha_revision

		annotation SummarizationSetBy = Automatic

	partition fact_reposicion = m
		mode: import
		source =
				// ===== fact_reposicion (121,960 filas)
				let
				    Origen = Csv.Document(File.Contents(RutaGold & "\fact_reposicion.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {
				        {"serie_id", type text},
				        {"item", type text},
				        {"store_code", type text},
				        {"fecha_revision", type date},
				        {"cobertura_dias", Int64.Type},
				        {"segmento", type text},
				        {"demanda_esperada", type number},
				        {"nivel_objetivo", Int64.Type},
				        {"stock_seguridad", Int64.Type},
				        {"nivel_servicio", type number},
				        {"metodo", type text},
				        {"modelo", type text},
				        {"version", type text}
				    }, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

