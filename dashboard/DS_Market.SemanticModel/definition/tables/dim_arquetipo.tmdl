	partition dim_arquetipo = m
		mode: import
		source =
				// ===== dim_arquetipo (6 filas)
				let
				    Origen = Csv.Document(File.Contents(RutaGold & "\dim_arquetipo.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {
				        {"grupo", Int64.Type},
				        {"arquetipo", type text},
				        {"productos", Int64.Type},
				        {"pct_catalogo", type number},
				        {"pct_facturacion", type number},
				        {"unidades_dia", type number},
				        {"pct_dias_sin_venta", type number},
				        {"fin_semana_vs_semana", type number},
				        {"diciembre_vs_resto", type number},
				        {"eventos_vs_normal", type number},
				        {"precio_medio", type number},
				        {"pct_accesorios", type number},
				        {"pct_hogar", type number},
				        {"pct_alimentacion", type number}
				    }, "en-US")
				in
				    Tipos

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

