	column es_temporada_alta
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 46178ca6-8e64-4ca4-a2cb-fd70afc6668a
		summarizeBy: none
		sourceColumn: es_temporada_alta

		annotation SummarizationSetBy = Automatic

	column es_futuro
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 301f3705-fa18-43f0-a85f-917be31864a5
		summarizeBy: none
		sourceColumn: es_futuro

		annotation SummarizationSetBy = Automatic

	column dia_corto =
			SWITCH ( dim_calendario[dia_semana], "Monday", "Lun", "Tuesday", "Mar", "Wednesday", "Mié", "Thursday", "Jue", "Friday", "Vie", "Saturday", "Sáb", "Sunday", "Dom" )
		dataType: string
		lineageTag: 1005d42a-e903-431b-932a-652e24377826
		summarizeBy: none
		sortByColumn: orden_dia

		annotation SummarizationSetBy = Automatic

	column orden_dia =
			SWITCH ( dim_calendario[dia_semana], "Monday", 1, "Tuesday", 2, "Wednesday", 3, "Thursday", 4, "Friday", 5, "Saturday", 6, "Sunday", 7 )
		dataType: int64
		formatString: 0
		lineageTag: cc6088f3-b9e4-49d8-9f54-ce9733a62dd9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column en_ventana_prevision =
			// últimas 5 semanas con ventas y las 4 semanas previstas
			VAR fin = MAX ( mart_ventas_dia[fecha] )
			RETURN dim_calendario[fecha] >= fin - 34
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 33eb29c1-3b7a-415c-aa32-60b67de410df
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_calendario = m
		mode: import
		source =
				// ===== dim_calendario (1,941 filas)
				let
				    Origen = Csv.Document(File.Contents(RutaGold & "\dim_calendario.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {
				        {"fecha", type date},
				        {"dia_id", type text},
				        {"dia_semana", type text},
				        {"weekday_int", Int64.Type},
				        {"anio", Int64.Type},
				        {"mes", Int64.Type},
				        {"semana_iso", Int64.Type},
				        {"evento", type text},
				        {"es_fin_de_semana", type logical},
				        {"es_dia_cierre", type logical},
				        {"es_temporada_alta", type logical},
				        {"es_futuro", type logical}
				    }, "en-US")
				in
				    Tipos

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

