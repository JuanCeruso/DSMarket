	partition mart_producto_perfil = m
		mode: import
		source =
				// ===== mart_producto_perfil (3,049 filas)
				let
				    Origen = Csv.Document(File.Contents(RutaGold & "\mart_producto_perfil.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {
				        {"item", type text},
				        {"unidades_total", type number},
				        {"dias_activo", Int64.Type},
				        {"unidades_dia", type number},
				        {"pct_dias_sin_venta", type number},
				        {"fin_semana_vs_semana", type number},
				        {"diciembre_vs_resto", type number},
				        {"eventos_vs_normal", type number},
				        {"precio_medio", type number},
				        {"facturacion", type number}
				    }, "en-US")
				in
				    Tipos

