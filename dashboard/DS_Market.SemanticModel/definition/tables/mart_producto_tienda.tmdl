	partition mart_producto_tienda = m
		mode: import
		source =
				// ===== mart_producto_tienda (30,490 filas)
				let
				    Origen = Csv.Document(File.Contents(RutaGold & "\mart_producto_tienda.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {
				        {"serie_id", type text},
				        {"item", type text},
				        {"store_code", type text},
				        {"arquetipo", type text},
				        {"categoria", type text},
				        {"departamento", type text},
				        {"ciudad", type text},
				        {"tienda", type text},
				        {"unidades_total", type number},
				        {"facturacion_total", type number},
				        {"precio_medio", type number}
				    }, "en-US")
				in
				    Tipos

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

