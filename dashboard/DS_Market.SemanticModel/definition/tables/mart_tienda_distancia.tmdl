	partition mart_tienda_distancia = m
		mode: import
		source =
				// ===== mart_tienda_distancia (100 filas)
				let
				    Origen = Csv.Document(File.Contents(RutaGold & "\mart_tienda_distancia.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {
				        {"store_code", type text},
				        {"tienda", type text},
				        {"store_code_otra", type text},
				        {"tienda_otra", type text},
				        {"distancia", type number},
				        {"orden_parecido", Int64.Type}
				    }, "en-US")
				in
				    Tipos

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table
