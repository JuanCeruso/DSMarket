	partition fact_predicciones = m
		mode: import
		source =
				// ===== fact_predicciones (853.720 filas, en 4 ficheros: una semana cada uno, por el límite de tamaño)
				let
				    Leer = (n) => Table.PromoteHeaders(Csv.Document(File.Contents(RutaGold & "\fact_predicciones_" & Text.From(n) & ".csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),
				    Unido = Table.Combine({Leer(1), Leer(2), Leer(3), Leer(4)}),
				    Tipos = Table.TransformColumnTypes(Unido, {
				        {"serie_id", type text}, {"item", type text}, {"store_code", type text},
				        {"fecha", type date}, {"prediccion_media", type number}, {"prediccion_p90", type number}
				    }, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

