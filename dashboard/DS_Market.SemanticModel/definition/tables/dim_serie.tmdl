	partition dim_serie = m
		mode: import
		source =
				// ===== dim_serie (30,490 filas)
				let
				    Origen = Csv.Document(File.Contents(RutaGold & "\dim_serie.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {
				        {"serie_id", type text},
				        {"item", type text},
				        {"store_code", type text},
				        {"unidades_90d", type number},
				        {"facturacion_90d", type number},
				        {"media_dia", type number},
				        {"desvio_dia", type number},
				        {"frac_dias_sin_venta", type number},
				        {"coef_variacion", type number},
				        {"clase_abc", type text},
				        {"clase_xyz", type text}
				    }, "en-US")
				in
				    Tipos

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

